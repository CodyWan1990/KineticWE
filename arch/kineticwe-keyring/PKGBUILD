# Maintainer: TheBlackDon <theblackdon@codeberg.org>
# Contributor: KineticWE project
#
# Signing keys of the KineticWE pacman repo, installed as a pacman keyring
# (same layout as archlinux-keyring). Built and published by CI next to the
# kineticwe packages.
#
# Changing the key (new subkey, rotation, revocation): replace kineticwe.gpg,
# kineticwe-trusted (primary fingerprint, "<FPR>:4:") and/or kineticwe-revoked
# (one fingerprint per line), bump pkgver to the date of the change, then run
# updpkgsums.

pkgname=kineticwe-keyring
pkgver=20261010
pkgrel=1
pkgdesc="KineticWE pacman repository signing keys"
arch=('any')
url="https://gitlab.com/theblackdon/kineticwe"
license=('GPL-2.0-or-later')
install=kineticwe-keyring.install
source=('kineticwe.gpg'
        'kineticwe-trusted'
        'kineticwe-revoked')
sha256sums=('465a7423c2ae80aca91c535b043aaa3705f8bb5bb579543c6a0f9a3c82dac750'
            'e5619c8f0770828b31439b9e4123b9277387586fdad9e0213a71de038df73ad1'
            'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855')

package() {
    install -Dm644 -t "$pkgdir/usr/share/pacman/keyrings/" \
        kineticwe.gpg kineticwe-trusted kineticwe-revoked
}
