# Import the shipped keys into pacman's keyring (as archlinux-keyring does).
# Skipped while pacman's keyring is not initialized yet (pacman-key --init).
post_upgrade() {
    if usr/bin/pacman-key -l >/dev/null 2>&1; then
        usr/bin/pacman-key --populate kineticwe
    fi
}

post_install() {
    if [ -x usr/bin/pacman-key ]; then
        post_upgrade
    fi
}
