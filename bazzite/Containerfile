# KineticWE bootc derivative image
#
# Builds a custom Bazzite-based image with KineticWE + Noctalia pre-layered.
# Users rebase to this image and get KineticWE out of the box.
#
# Usage:
#   podman build -t kineticwe-bazzite:stable .
#   bootc switch ghcr.io/youruser/kineticwe-bazzite:stable
#
# To rebuild after KineticWE updates:
#   podman build --no-cache -t kineticwe-bazzite:stable .
#   podman push ghcr.io/youruser/kineticwe-bazzite:stable
#   bootc upgrade

FROM ghcr.io/ublue-os/bazzite-nvidia:stable

# Enable COPR repositories for KineticWE and Noctalia
RUN dnf -y copr enable lionheartp/Hyprland && \
    dnf -y copr enable theblackdon/kineticwe

# Layer KineticWE and Noctalia packages
RUN rpm-ostree install kineticwe noctalia-git && \
    rpm-ostree cleanup -m && \
    dnf clean all
