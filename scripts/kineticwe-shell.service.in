# KineticWE shell (Noctalia fork, noctalia-kwe) as a systemd user unit.
#
# Started by start-kineticwe once the compositor is up and the session
# environment (WAYLAND_DISPLAY, DISPLAY, ...) has been published to the user
# manager; stopped with kineticwe-session.target when the session ends. Not a
# Wants= of the target, so launchers that run their own shell (Nix) are
# unaffected.
#
# Restart=always: Meta+Alt+R restarts this unit through systemd, with a
# path-anchored `pkill` fallback in sessions that have no unit, and SIGTERM
# counts as a clean exit that Restart=on-failure would not undo.
#
# KillMode=process: apps launched from the launcher, dock and taskbar get their
# own app-*.service units (launch_apps_as_systemd_services), but other shell
# spawns (custom commands, xdg-open, widget commands) stay in this unit's
# cgroup. Only noctalia-kwe itself is stopped on restart, so those survive a
# shell restart or crash, as they did under the old supervised loop.
#
# Session guard: start-kineticwe publishes the compositor PID to
# $XDG_RUNTIME_DIR/kineticwe-compositor.pid and withdraws it again on teardown.
# The ExecCondition re-checks that PID on every start attempt, including each
# Restart=always attempt, so a shell belonging to a dead session cannot be
# resurrected in the next one. Requires systemd >= 243.
#
# @INSTALL_PREFIX@ is filled in at install time like start-kineticwe.

[Unit]
Description=KineticWE Shell (Noctalia)
PartOf=kineticwe-session.target graphical-session.target
After=kineticwe-session.target
Before=xdg-desktop-autostart.target

[Service]
Type=simple
# Only start while the compositor that owns this shell is alive. No '-' prefix:
# a failed check must skip the unit, not start it. $$ defers shell variables to
# /bin/sh; %t is the user runtime directory.
ExecCondition=/bin/sh -c 'p=%t/kineticwe-compositor.pid; test -s "$$p" || exit 1; IFS= read -r pid < "$$p" || exit 1; test -n "$$pid" || exit 1; case "$$pid" in *[!0-9]*) exit 1;; esac; test "$$pid" -gt 1 || exit 1; kill -0 "$$pid" 2>/dev/null || exit 1; IFS= read -r comm < "/proc/$$pid/comm" || exit 1; case "$$comm" in *kinetic-we*) ;; *) exit 1;; esac'
ExecStart=@INSTALL_PREFIX@/bin/noctalia-kwe
Restart=always
RestartSec=2
KillMode=process
