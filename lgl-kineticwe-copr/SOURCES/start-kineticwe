#!/bin/bash
# KineticWE RPM session launcher.

set -e

export XDG_CURRENT_DESKTOP=KineticWE:KDE
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=kineticwe
export KDE_SESSION_VERSION=6
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:$PATH"

find_portal() {
    local name="$1"
    for path in \
        "/usr/libexec/$name" \
        "/usr/lib/$name"
    do
        if [[ -x "$path" ]]; then
            printf '%s\n' "$path"
            return 0
        fi
    done
    command -v "$name" 2>/dev/null || true
}

PORTAL_KDE="$(find_portal xdg-desktop-portal-kde)"
PORTAL="$(find_portal xdg-desktop-portal)"

STARTUP_PAYLOAD_DIR="${XDG_RUNTIME_DIR:-/tmp}/kineticwe-$USER"
mkdir -p "$STARTUP_PAYLOAD_DIR"
STARTUP_PAYLOAD="$STARTUP_PAYLOAD_DIR/startup.sh"

cat > "$STARTUP_PAYLOAD" << EOF
#!/bin/bash
export XDG_CURRENT_DESKTOP=KineticWE:KDE
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=kineticwe
export KDE_SESSION_VERSION=6
export PATH="\$HOME/.local/bin:/usr/local/bin:/usr/bin:\$PATH"

killall -q xdg-desktop-portal-kde xdg-desktop-portal xdg-desktop-portal-gtk xdg-document-portal 2>/dev/null || true
sleep 1

mkdir -p "\$HOME/.local/share"

if [[ -x "$PORTAL_KDE" ]]; then
    # xdg-desktop-portal-kde only registers the Wayland-integration portals
    # (ScreenCast, Screenshot, RemoteDesktop, Clipboard, GlobalShortcuts,
    # InputCapture, Background, Wallpaper) when XDG_CURRENT_DESKTOP is
    # exactly "KDE" (desktopportal.cpp does a plain string compare, not a
    # colon-list check). Override it for this one process only so the rest
    # of the session can keep showing as "KineticWE:KDE".
    XDG_CURRENT_DESKTOP=KDE nohup "$PORTAL_KDE" >"\$HOME/.local/share/xdg-desktop-portal-kde.log" 2>&1 &
else
    echo "Warning: xdg-desktop-portal-kde not found" >&2
fi

sleep 2

if [[ -x "$PORTAL" ]]; then
    nohup "$PORTAL" >"\$HOME/.local/share/xdg-desktop-portal.log" 2>&1 &
else
    echo "Warning: xdg-desktop-portal not found" >&2
fi

# Power management
if [[ -x /usr/libexec/upowerd ]]; then
    /usr/libexec/upowerd &>/dev/null &
fi

if [[ -x /usr/libexec/org_kde_powerdevil ]]; then
    /usr/libexec/org_kde_powerdevil &>/dev/null &
fi

if command -v noctalia >/dev/null 2>&1; then
    nohup noctalia >"\$HOME/.local/share/noctalia.log" 2>&1 &
else
    echo "Warning: noctalia not found" >"\$HOME/.local/share/noctalia.log"
fi
EOF

chmod +x "$STARTUP_PAYLOAD"

# KineticWE embeds KGlobalAccelD. Stop a leftover standalone daemon so the
# compositor can own org.kde.kglobalaccel and global shortcuts work.
systemctl --user stop plasma-kglobalaccel.service 2>/dev/null || true
pkill -x kglobalacceld 2>/dev/null || true

# Prefer dev build, fall back to system install
if [[ -x "$HOME/.local/bin/kinetic-we" ]]; then
    exec "$HOME/.local/bin/kinetic-we" --xwayland "$STARTUP_PAYLOAD"
else
    exec /usr/bin/kinetic-we --xwayland "$STARTUP_PAYLOAD"
fi
