[Desktop Entry]
Type=Application
Name=Noctalia
Comment=A sleek, customizable desktop shell crafted for Wayland.
Exec=noctalia-kwe --daemon
Icon=noctalia-kwe
Terminal=false
Categories=Settings;DesktopSettings;
StartupNotify=false
Actions=Settings;
Keywords=desktop;shell;wayland;

[Desktop Action Settings]
Name=Open Settings
Exec=sh -c "noctalia-kwe msg settings-open || { noctalia-kwe --daemon && noctalia-kwe msg settings-open; }"
